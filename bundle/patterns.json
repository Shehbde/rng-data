{
  "version": 1,
  "notes": "All regexes run on formatting-stripped text. Sources: tools/research/*.md (SkyHanni/Skyblocker/Firmament regex tests, hypixelskyblock.minecraft.wiki). Keys are referenced from Java; named groups are part of the contract.",
  "patterns": {
    "chat.drop": {
      "regex": "^(?!.*:)(?<tier>RARE|VERY RARE|CRAZY RARE|INSANE|PET|UNCOMMON|PRAY TO RNGESUS) DROP!\\s+(?<rest>.+?)\\s*$",
      "verified": true,
      "source": "Skyblocker RareDropSpecialEffects / SkyHanni regex tests; tools/research/messages-slayer-mining-farming-combat-diana.md §1"
    },
    "chat.rareCrop": {
      "regex": "^(?!.*:)(?<tier>RARE|VERY RARE) CROP!\\s+(?<rest>.+?)\\s*$",
      "verified": true,
      "source": "SkyHanni RareCropTracker tests"
    },
    "chat.specialFind": {
      "regex": "^(?!.*:)(?<tier>ABOUT TIME)! You find (?:an? )?(?<rest>.+?)!\\s*$",
      "verified": true,
      "source": "community wiki Overclocker 3000"
    },
    "chat.dropBonus": {
      "regex": "\\s*\\((?<bonus>\\+[^()]*)\\)(?:\\s*\\(automatically donated\\))?\\s*$",
      "verified": true,
      "source": "trailing (+N% ✯ Magic Find) / (+N<overbloom>)"
    },
    "chat.magicFind": {
      "regex": "\\+(?<mf>[\\d,.]+)%?\\s*\\S*\\s*Magic Find",
      "verified": true,
      "source": "Magic Find suffix; icon is ✯ or U+E01A"
    },
    "chat.dropWrapper": {
      "regex": "^(?:You dug out (?:a |an )?|You dropped )(?<item>.+?)!?$",
      "verified": true,
      "source": "Diana treasure / Crop Fever drop lines"
    },
    "chat.countPrefix": {
      "regex": "^(?<count>\\d+)x (?<item>.+)$",
      "verified": true,
      "source": "(2x Foul Flesh)"
    },
    "chat.countSuffix": {
      "regex": "^(?<item>.+?) x(?<count>\\d+)$",
      "verified": true,
      "source": "pest drops: Mutant Nether Wart x9"
    },
    "chat.otherPlayerDrop": {
      "regex": "^(?:\\[[^\\]]+\\] )?\\w{3,16} has obtained .+!$",
      "verified": true,
      "source": "lobby broadcast '<player> has obtained [Lvl 1] Bal!'"
    },
    "chat.profile": {
      "regex": "^You are playing on profile: (?<profile>[\\w ]+?)(?: \\(.*\\))?$",
      "verified": true,
      "source": "SkyHanni chat-filter profile-join"
    },
    "chat.slayerStarted": {
      "regex": "^\\s*SLAYER QUEST STARTED!$",
      "verified": true,
      "source": "SkyHanni SlayerApi"
    },
    "chat.slayerBossSlain": {
      "regex": "^\\s*NICE! SLAYER BOSS SLAIN!$",
      "verified": true,
      "source": "SkyHanni ChatFilter"
    },
    "chat.slayerComplete": {
      "regex": "^\\s*SLAYER QUEST COMPLETE!$",
      "verified": true,
      "source": "SkyHanni/Skyblocker"
    },
    "chat.slayerFailed": {
      "regex": "^\\s*SLAYER QUEST FAILED!$",
      "verified": true,
      "source": "SkyHanni/Skyblocker"
    },
    "chat.slayerCancelled": {
      "regex": "^Your Slayer Quest has been cancelled!$",
      "verified": true,
      "source": "Skyblocker"
    },
    "chat.slayerCocooned": {
      "regex": "^\\s*YOU COCOONED YOUR SLAYER BOSS$",
      "verified": true,
      "source": "SkyHanni/Skyblocker"
    },
    "chat.rngMeter": {
      "regex": "^\\s*RNG Meter - (?<xp>[\\d,]+) Stored XP$",
      "verified": true,
      "source": "Skyblocker"
    },
    "chat.wormSpawn": {
      "regex": "^You hear the sound of something approaching\\.\\.\\.$",
      "verified": true,
      "source": "Scatha / Stoneworm spawn (personal); creature decided by nametag"
    },
    "chat.corpseLoot": {
      "regex": "^(?<type>LAPIS|UMBER|TUNGSTEN|VANGUARD) CORPSE LOOT!\\s*$",
      "verified": true,
      "source": "Glacite Mineshaft corpse loot block: SkyHanni CorpseLoot.kt (mining.mineshaft.chat.start/item/end) + Skyblocker CorpseProfitTracker.java (stripped), checked against real chat logs; docs/scenes/encased.md"
    },
    "chat.corpseRewards": {
      "regex": "^REWARDS$",
      "verified": true,
      "source": "Glacite Mineshaft corpse loot block: SkyHanni CorpseLoot.kt (mining.mineshaft.chat.start/item/end) + Skyblocker CorpseProfitTracker.java (stripped), checked against real chat logs; docs/scenes/encased.md"
    },
    "chat.corpseItem": {
      "regex": "^(?:[^A-Za-z0-9(]+\\s*)?(?<item>[A-Za-z0-9(].*?)(?: x(?<count>[\\d,]+))?$",
      "verified": true,
      "source": "Glacite Mineshaft corpse loot block: SkyHanni CorpseLoot.kt (mining.mineshaft.chat.start/item/end) + Skyblocker CorpseProfitTracker.java (stripped), checked against real chat logs; docs/scenes/encased.md; leading gemstone icons (legacy symbols or private-use glyphs) are skipped"
    },
    "chat.corpseSkip": {
      "regex": "^(?:\\+[\\d,]+ HOTM Experience|Glacite Powder(?: x[\\d,]+)?)$",
      "verified": true,
      "source": "Glacite Mineshaft corpse loot block: SkyHanni CorpseLoot.kt (mining.mineshaft.chat.start/item/end) + Skyblocker CorpseProfitTracker.java (stripped), checked against real chat logs; docs/scenes/encased.md (powder and HOTM XP are not items)"
    },
    "chat.corpseEnd": {
      "regex": "^▬{20,}$",
      "verified": true,
      "source": "Glacite Mineshaft corpse loot block: SkyHanni CorpseLoot.kt (mining.mineshaft.chat.start/item/end) + Skyblocker CorpseProfitTracker.java (stripped), checked against real chat logs; docs/scenes/encased.md (64x ▬)"
    },
    "chat.dianaDig": {
      "regex": "^(?:Oh|Uh oh|Yikes|Oi|Good Grief|Danger|Woah)! You dug out (?:a |an )?(?<mob>[A-Za-z' ]+)!$",
      "verified": true,
      "source": "SkyHanni GriffinBurrowHelper tests"
    },
    "chat.dianaPrefixes": {
      "regex": "^(?:Blessed|Stalwart|Venerable|Exalted|Empyrean) ",
      "verified": true,
      "source": "Griffin rarity prefixes on Diana mob names"
    },
    "chat.treeGiftHeader": {
      "regex": "^\\s*TREE GIFT\\s*$",
      "verified": true,
      "source": "SkyHanni ForagingTracker regex tests (features/foraging/ForagingTracker.kt), see docs/scenes/coverage.md"
    },
    "chat.treeGiftCut": {
      "regex": "^\\s*You helped cut (?<pct>[\\d.]+)% of the (?<tree>[A-Za-z ]+?) Tree\\.?\\s*$",
      "verified": true,
      "source": "SkyHanni ForagingTracker regex tests (features/foraging/ForagingTracker.kt), see docs/scenes/coverage.md"
    },
    "chat.treeGiftBonus": {
      "regex": "^\\s*BONUS GIFT\\s*$",
      "verified": true,
      "source": "SkyHanni ForagingTracker regex tests (features/foraging/ForagingTracker.kt), see docs/scenes/coverage.md"
    },
    "chat.treeGiftItem": {
      "regex": "^\\s*(?<item>[^:]+?) \\((?<pct>[\\d.,]+)%\\)\\s*$",
      "verified": true,
      "source": "SkyHanni ForagingTracker regex tests (features/foraging/ForagingTracker.kt), see docs/scenes/coverage.md"
    },
    "chat.treeGiftEnd": {
      "regex": "^\\s*▬{6,}\\s*$",
      "verified": false,
      "source": "separator line closing the gift block (SkyHanni fixture); exact length unverified"
    },
    "chat.doubleHook": {
      "regex": "^It's a Double Hook!(?: Woot woot!)?$",
      "verified": true,
      "source": "fishing double hook"
    },
    "chat.dungeonEnd": {
      "regex": "^\\s*(?<master>Master Mode )?The Catacombs - Floor (?<floor>[IV]+|Entrance)$",
      "verified": true,
      "source": "end-of-run chat header"
    },
    "chat.kuudraDown": {
      "regex": "^\\s*KUUDRA DOWN!$",
      "verified": true,
      "source": "Kuudra end of fight"
    },
    "scoreboard.area": {
      "regex": "^\\s*[⏣ф] (?<area>.+)$",
      "verified": true,
      "source": "SkyHanni ScoreboardPattern"
    },
    "scoreboard.dungeonFloor": {
      "regex": "The Catacombs \\((?<floor>[FM][1-7]|E)\\)",
      "verified": true,
      "source": " ⏣ The Catacombs (F7)"
    },
    "scoreboard.kuudraTier": {
      "regex": "Kuudra's Hollow \\(T(?<tier>[1-5])\\)",
      "verified": true,
      "source": " ⏣ Kuudra's Hollow (T5)"
    },
    "scoreboard.slayerQuest": {
      "regex": "^Slayer Quest$",
      "verified": true,
      "source": "SkyHanni SlayerApi"
    },
    "scoreboard.slayBoss": {
      "regex": "^Slay the boss!$",
      "verified": true,
      "source": "SkyHanni SlayerApi"
    },
    "scoreboard.bossSlain": {
      "regex": "^Boss slain!$",
      "verified": true,
      "source": "SkyHanni SlayerApi"
    },
    "tab.profile": {
      "regex": "^Profile: (?<profile>[\\w ]+?)(?:\\s*[♲Ⓑ☀].*)?$",
      "verified": true,
      "source": "tab list widget"
    },
    "tab.area": {
      "regex": "^Area: (?<area>.+)$",
      "verified": true,
      "source": "tab list widget"
    },
    "nametag.slayerBoss": {
      "regex": "^(?:\\[Lv\\d+\\] )?(?:\\S+ )?☠ (?<name>[A-Za-z' ]+?)(?: (?<tier>IV|V|I{1,3}))? (?<hp>[\\d.,]+[kMB]?)(?:/(?<max>[\\d.,]+[kMB]?))?[❤\\uE010]$",
      "verified": true,
      "source": "SkyHanni MobFilter REGEX-TESTs; heart can be U+2764 or U+E010"
    },
    "nametag.slayerBossHits": {
      "regex": "^(?:\\[Lv\\d+\\] )?(?:\\S+ )?☠ (?<name>[A-Za-z' ]+?)(?: (?<tier>IV|V|I{1,3}))? (?<hits>\\d+) Hits?$",
      "verified": true,
      "source": "Voidgloom hits-shield phase"
    },
    "nametag.spawnedBy": {
      "regex": "^Spawned by: (?<player>\\w{1,16})$",
      "verified": true,
      "source": "SkyHanni/Skyblocker"
    },
    "nametag.creature": {
      "regex": "^(?:\\[Lv\\d+\\] )?(?:[^A-Za-z\\[]+ )?(?<name>[A-Z][A-Za-z' ]+?)(?: ᛤ)? (?<hp>[\\d.,]+[kMB]?)/(?<max>[\\d.,]+[kMB]?)[❤\\uE010]$",
      "verified": true,
      "source": "sea creature / Diana mob nametag: [Lv597] Lord Jawbus 100M/100M❤"
    },
    "title.dungeonChest": {
      "regex": "^(?<chest>Wood|Gold|Diamond|Emerald|Obsidian|Bedrock)(?: Chest)?$",
      "verified": true,
      "source": "Skyblocker/SkyHanni"
    },
    "title.kuudraChest": {
      "regex": "^(?<chest>Free|Paid) Chest(?: Chest)?$",
      "verified": true,
      "source": "Hypixel doubles the word"
    },
    "title.croesus": {
      "regex": "^(?:\\(\\d+/\\d+\\) )?(?:Croesus|Vesuvius)$",
      "verified": true,
      "source": "Croesus / Vesuvius menus"
    },
    "title.croesusDungeonRun": {
      "regex": "^(?<master>Master )?Catacombs - Floor (?<floor>[IV]+)$",
      "verified": true,
      "source": "Croesus per-run view"
    },
    "title.croesusKuudraRun": {
      "regex": "^Kuudra - (?<tier>Basic|Hot|Burning|Fiery|Infernal)$",
      "verified": true,
      "source": "Vesuvius per-run view"
    },
    "lore.openReward": {
      "regex": "^Open Reward Chest$",
      "verified": true,
      "source": "slot 31 button name"
    },
    "lore.alreadyOpened": {
      "regex": "^(?:Already opened!|You already opened this chest!?)$",
      "verified": false,
      "source": "Croesus lore; needs in-game check"
    },
    "actionbar.abilityUse": {
      "regex": "-(?<mana>[\\d,]+) Mana \\((?<ability>[^)]+)\\)",
      "verified": true,
      "source": "SkyHanni (SackApi sackChangePattern, ItemAbilityCooldown abilityUsePattern, DamageIndicatorManager damagePattern); verified against their REGEX-TEST fixtures"
    },
    "nametag.damage": {
      "regex": "^[✧✯]?[\\d,]+[⚔+✧❤♞☄✷ﬗ✯]*$",
      "verified": true,
      "source": "SkyHanni (SackApi sackChangePattern, ItemAbilityCooldown abilityUsePattern, DamageIndicatorManager damagePattern); verified against their REGEX-TEST fixtures"
    },
    "chat.sacks": {
      "regex": "^\\[Sacks\\] ",
      "verified": true,
      "source": "SkyHanni (SackApi sackChangePattern, ItemAbilityCooldown abilityUsePattern, DamageIndicatorManager damagePattern); verified against their REGEX-TEST fixtures"
    },
    "chat.sackPeriod": {
      "regex": "\\(Last (?<sec>\\d+)s\\.\\)",
      "verified": false,
      "source": "\"(Last Ns.)\" suffix of the [Sacks] line; the period length is unverified (assume 5 s when missing)"
    },
    "chat.sackChange": {
      "regex": "^ *(?<delta>[+-][\\d,]+) (?<item>.+) \\((?<sacks>.+)\\)$",
      "verified": true,
      "source": "SkyHanni (SackApi sackChangePattern, ItemAbilityCooldown abilityUsePattern, DamageIndicatorManager damagePattern); verified against their REGEX-TEST fixtures"
    }
  },
  "dropTiers": {
    "RARE": "RARE",
    "VERY RARE": "VERY_RARE",
    "CRAZY RARE": "CRAZY_RARE",
    "INSANE": "INSANE",
    "PET": "PET",
    "UNCOMMON": "UNCOMMON",
    "PRAY TO RNGESUS": "PRAY_TO_RNGESUS",
    "ABOUT TIME": "VERY_RARE"
  },
  "suppressSounds": [
    "minecraft:block.note_block.pling",
    "minecraft:entity.player.levelup"
  ]
}
